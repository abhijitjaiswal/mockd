# --- never commit: secrets -------------------------------------------------
.env
environments.local.json

# --- never commit: your API's own documents --------------------------------
# The tool is generic; the document it points at is yours. Fetched and
# uploaded specs land in specs/, and the overlay is generated from them.
specs/
apis.json
mock_overlay.json
learned_overlay.json
spec.lock.json
mockd.json

# --- working state ---------------------------------------------------------
tests/drafts/
.mockd-console.json
logs/
server.log
verify_report.*
__pycache__/
*.pyc
.venv/
venv/

# --- demo artefacts --------------------------------------------------------
demo/node_modules/
demo/shots/
# Regenerated by the suites from whatever spec is loaded, so they capture
# whichever API you point the tool at. Build output, not source.
demo/ui/
demo/*.mp4
demo/*.zip

# --- editors and OS --------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- generated from your API, not part of the tool -------------------------
*.postman_collection.json
tests/*.json

# --- local overrides: your API's shape, never the tool's ------------------
conventions.local.json
demo/endpoints.local.js
