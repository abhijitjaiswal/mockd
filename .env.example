# Copy to .env (gitignored). Anything here fills a ${VAR} in environments.json,
# so the committed file never holds a URL, a credential or an environment id.
DEV_BASE_URL=https://api.dev.example.com
DEV_USERNAME=qa.bot@example.com
DEV_PASSWORD=
# Or skip the login and paste a cookie from your browser instead:
DEV_COOKIE=access_token=...
DEV_DEPARTMENT_ID=
DEV_USER_ID=

STAGING_BASE_URL=https://api.staging.example.com
STAGING_TOKEN=
STAGING_DEPARTMENT_ID=
